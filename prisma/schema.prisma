// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider    = "prisma-client"
  output      = "../app/generated/prisma"
  engineType  = "client"
}

datasource db {
  provider = "sqlite"
}

model Intern {
  id String @id @default(uuid()) @map("ID")

  //user contact information
  user_name  String
  user_email String //@unique
  user_phone String //@unique

  next_shift_ID String?
  next_shift    Scheduled_day? @relation("next_shift", fields: [next_shift_ID], references: [id])

  site_manager Site_Manager? @relation("site_manager_profile")

  //collection of their attendance history and future scheduled shifts
  attendance_history Attendance[]

  created_shift_requests   Shift_Request[] @relation("created_shift_requests")
  picked_up_shift_requests Shift_Request[] @relation("picked_up_shift_requests")
}

//extension of user roles for Site managers also contains their managed site
model Site_Manager {
  id String @id @default(uuid())

  intern_ID String @unique
  intern    Intern @relation("site_manager_profile", fields: [intern_ID], references: [id])

  locations Location[]
}

model Location {
  id String @id @default(uuid())

  location_name String
  address       String

  attendance_code String?
  code_expires_at DateTime?

  managers       Site_Manager[]
  scheduled_days Scheduled_day[]
}

model Scheduled_day {
  id String @id @default(uuid())

  start_time DateTime
  end_time   DateTime

  site_ID  String
  location Location @relation(fields: [site_ID], references: [id])

  attendance Attendance[]

  next_shift_for Intern[] @relation("next_shift")
}

//1 to many user has many attendances,
model Attendance {
  id String @id @default(uuid()) //unique identifier

  //clock in time and out time and current attendance status
  clock_in_time  DateTime?
  clock_out_time DateTime?
  status         Attendance_status @default(ABSENT) //defualt being absent

  internID String
  intern   Intern @relation(fields: [internID], references: [id])

  shift_ID      String
  scheduled_day Scheduled_day @relation(fields: [shift_ID], references: [id])

  shift_request_ID String?
  shift_request    Shift_Request? @relation(fields: [shift_request_ID], references: [id])
}

model Shift_Request {
  id String @id @default(uuid())

  reason    String?
  createdAt DateTime @default(now())

  created_by_ID String
  created_by    Intern @relation("created_shift_requests", fields: [created_by_ID], references: [id])

  picked_up_by_ID String?
  picked_up_by    Intern? @relation("picked_up_shift_requests", fields: [picked_up_by_ID], references: [id])

  attendances Attendance[]
}

model Admin {
  id String @id @default(uuid())

  name  String
  email String
}

//the below are enums that are used to signify status's
enum Attendance_status {
  ABSENT
  PRESENT
  CALLED_OFF
  COVERING_SHIFT
}
